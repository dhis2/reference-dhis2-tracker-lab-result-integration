"local getEntry(entries, resourceType) = ds.filter(entries, function(e, i) e.resource.resourceType == resourceType)[0];\n\nlocal observation = getEntry(body.entry, 'Observation').resource;\nlocal specimen = getEntry(body.entry, 'Specimen').resource;\n\n{\n  \"events\": [\n    {\n      \"orgUnit\": cml.variable('labRequestEvent').orgUnit,\n      \"occurredAt\": ds.datetime.parse(observation.effectiveDateTime).format('yyyy-MM-dd'),\n      \"status\": \"COMPLETED\",\n      \"program\": cml.variable('labRequestEvent').program,\n      \"programStage\": \"mDvE6kdNpty\",\n      \"enrollment\": cml.variable('enrollmentId'),\n      \"dataValues\": [\n        {\n          \"dataElement\": \"CS_SPECIMEN_ID\",\n          \"value\": specimen.accessionIdentifier.value\n        },\n        {\n          \"dataElement\": \"CS_DATE_SPECIMEN_RECEIVED_AT_LAB\",\n          \"value\": ds.datetime.parse(specimen.receivedTime).format('yyyy-MM-dd')\n        },\n        {\n          \"dataElement\": cml.variable('deCodeDict')[observation.code.coding[0].code],\n          \"value\": cml.variable('optValueCodeDict')[observation.valueCodeableConcept.coding[0].code]\n        }\n      ]\n    }\n  ]\n}"