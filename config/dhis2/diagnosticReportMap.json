"local getEntry(entries, resourceType) = ds.filter(entries, function(e, i) e.resource.resourceType == resourceType)[0];\n\nlocal observation = getEntry(body.entry, 'Observation').resource;\nlocal specimen = getEntry(body.entry, 'Specimen').resource;\n\n{\n  \"events\": [\n    {\n      \"orgUnit\": cml.variable('labRequestEvent').orgUnit,\n      \"occurredAt\": ds.datetime.parse(observation.effectiveDateTime).format('yyyy-MM-dd'),\n      \"status\": \"COMPLETED\",\n      \"program\": cml.variable('labRequestEvent').program,\n      \"programStage\": \"mDvE6kdNpty\",\n      \"enrollment\": cml.variable('enrollmentId'),\n      \"dataValues\": [\n        {\n          \"dataElement\": \"CS_SPECIMEN_ID\",\n          \"value\": specimen.accessionIdentifier.value\n        },\n        {\n          \"dataElement\": \"CS_DATE_SPECIMEN_RECEIVED_AT_LAB\",\n          \"value\": ds.datetime.parse(specimen.receivedTime).format('yyyy-MM-dd')\n        }\n      ] + (if observation.code.coding[0].code == \"75411-9\" then [{\n            \"dataElement\": \"CS_LAB_RT_PCR\",\n            \"value\": (if observation.valueCodeableConcept.coding[0].code == \"LA11882-0\" then \"POSITIVE\"\n                      else if observation.valueCodeableConcept.coding[0].code == \"LA11883-8\" then \"NEGATIVE\")\n         }] else if observation.code.coding[0].code == \"71768-6\" then [{\n            \"dataElement\": \"CS_LAB_ANTIGEN_DETECTION\",\n            \"value\": (if observation.valueCodeableConcept.coding[0].code == \"LA6576-8\" then \"POSITIVE\"\n                      else if observation.valueCodeableConcept.coding[0].code == \"LA6577-6\" then \"NEGATIVE\")\n         }] else if observation.code.coding[0].code == \"71770-2\" then [{\n            \"dataElement\": \"CS_LAB_IGG_SEROLOGY\",\n            \"value\": (if observation.valueCodeableConcept.coding[0].code == \"LA6576-8\" then \"POSITIVE\"\n                      else if observation.valueCodeableConcept.coding[0].code == \"LA6577-6\" then \"NEGATIVE\")\n        }] else if observation.code.coding[0].code == \"41637-0\" then [{\n            \"dataElement\": \"CS_LAB_IMMUNOFLUORESCENCE\",\n            \"value\": (if observation.valueCodeableConcept.coding[0].code == \"LA6576-8\" then \"POSITIVE\"\n                      else if observation.valueCodeableConcept.coding[0].code == \"LA6577-6\" then \"NEGATIVE\")\n         }])\n    }\n  ]\n}"