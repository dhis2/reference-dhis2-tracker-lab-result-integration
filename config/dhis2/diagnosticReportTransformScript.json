"local getEntries(entries, resourceType) = ds.filter(entries, function(e, i) e.resource.resourceType == resourceType);\nlocal getFirstEntry(entries, resourceType) = getEntries(entries, resourceType)[0];\n\nlocal observations = getEntries(body.entry, 'Observation');\nlocal specimen = getFirstEntry(body.entry, 'Specimen').resource;\nlocal diagnosticReport = getFirstEntry(body.entry, 'DiagnosticReport').resource;\n\n{\n  \"events\": [\n    {\n      [if cml.variable('labReportEvent') != null then \"event\"]: cml.variable('labReportEvent').event,\n      \"updatedAt\": diagnosticReport.meta.lastUpdated,\n      \"orgUnit\": cml.variable('labRequestEvent').orgUnit,\n      \"occurredAt\": ds.datetime.parse(diagnosticReport.effectiveDateTime).format('yyyy-MM-dd'),\n      \"status\": \"COMPLETED\",\n      \"program\": cml.variable('labRequestEvent').program,\n      \"programStage\": \"mDvE6kdNpty\",\n      \"enrollment\": cml.variable('enrollmentId'),\n      \"notes\": [\n        {\n          \"value\": diagnosticReport.status\n        }\n      ],\n      \"dataValues\": [\n        {\n          \"dataElement\": \"CS_SPECIMEN_ID\",\n          \"value\": specimen.accessionIdentifier.value\n        },\n        {\n          \"dataElement\": \"CS_DATE_SPECIMEN_RECEIVED_AT_LAB\",\n          \"value\": ds.datetime.parse(specimen.receivedTime).format('yyyy-MM-dd')\n        }\n      ] +\n      [\n        {\n          \"dataElement\": if std.objectHas(observation.resource.code, \"coding\") then cml.variable('dataElementCodeDict')[observation.resource.code.coding[0].code] else observation.resource.code.text,\n          \"value\": if std.objectHas(observation.resource.valueCodeableConcept, \"coding\") then cml.variable('optionCodeDict')[observation.resource.valueCodeableConcept.coding[0].code] else observation.resource.valueCodeableConcept.text\n        } for observation in observations\n      ]\n    }\n  ]\n}"