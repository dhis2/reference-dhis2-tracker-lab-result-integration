{
  "name": "reference-dhis2-tracker-lab-result-integration",
  "version": "1.0.0",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.7.3",
    "concurrently": "^9.0.1",
    "wait-on": "^8.0.1",
    "@usebruno/cli": "4.1.0"
  },
  "scripts": {
    "build-iol": "cd iol/; node -e \"process.exit(process.platform === 'win32' ? 0 : 1)\" && mvnw.cmd -B clean package -Dmaven.test.skip=true || ./mvnw -B clean package -Dmaven.test.skip=true",
    "build": "concurrently --kill-others-on-fail \"yarn:build-iol\"",
    "start-services": "docker compose up --wait --build --renew-anon-volumes --force-recreate --remove-orphans",
    "start": "concurrently --kill-others-on-fail \"yarn:start-services\"",
    "test": "playwright test",
    "simulate": "cd tests/create-fake-lab-diagnostic-report-collection; bru run fetch-lab-requests-from-dhis2.yml"
  }
}
